<robot name="dynaarm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Example single arm setup -->

  <xacro:arg name="tf_prefix" default="" />

  <!-- simple, complex -->
  <xacro:arg name="collision" default="complex" />
  <!-- real, mock, sim -->
  <xacro:arg name="mode" default="mock" />
  <!-- physical ethercat bus, only used for real -->
  <xacro:arg name="ethercat_bus" default="eth0" />
  <!-- v1, v2, ... -->
  <xacro:arg name="version" default="baracuda12" />

  <xacro:arg name="namespace" default="" />

  <!-- example definition of custom control limits; remove if not needed -->
  <xacro:arg name="shoulder_rotation_limit_vel" default="" />
  <xacro:arg name="shoulder_flexion_limit_vel" default="" />
  <xacro:arg name="elbow_flexion_limit_vel" default="" />
  <xacro:arg name="forearm_rotation_limit_vel" default="" />
  <xacro:arg name="wrist_flexion_limit_vel" default="" />
  <xacro:arg name="wrist_rotation_limit_vel" default="" />

  <xacro:arg name="shoulder_rotation_limit_effort" default="" />
  <xacro:arg name="shoulder_flexion_limit_effort" default="" />
  <xacro:arg name="elbow_flexion_limit_effort" default="" />
  <xacro:arg name="forearm_rotation_limit_effort" default="" />
  <xacro:arg name="wrist_flexion_limit_effort" default="" />
  <xacro:arg name="wrist_rotation_limit_effort" default="" />

  <!-- load robot description -->
  <xacro:include filename="$(find duatic_dynaarm_driver)/urdf/dynaarm.urdf.xacro" />

  <link name="base_link" />

  <link name="table">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="1.0 1.0 0.05" />
      </geometry>
      <material name="Wood">
        <color rgba="0.9 0.83 0.733 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="1.0 1.0 0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
    </inertial>
  </link>

  <joint name="table_joint" type="fixed">
    <parent link="base_link" />
    <child link="table" />
    <origin xyz="0 0 -0.025" rpy="0 0 0" />
  </joint>

  <!-- create an instance of the dynaarm and fix its base-->
  <xacro:dynaarm tf_prefix="$(arg tf_prefix)"
    parent_link="table"
    collision="$(arg collision)"
    mode="$(arg mode)"
    ethercat_bus="$(arg ethercat_bus)"
    version="$(arg version)"
    joint_1_limit_vel="$(arg shoulder_rotation_limit_vel)"
    joint_2_limit_vel="$(arg shoulder_flexion_limit_vel)"
    joint_3_limit_vel="$(arg elbow_flexion_limit_vel)"
    joint_4_limit_vel="$(arg forearm_rotation_limit_vel)"
    joint_5_limit_vel="$(arg wrist_flexion_limit_vel)"
    joint_6_limit_vel="$(arg wrist_rotation_limit_vel)"
    joint_1_limit_effort="$(arg shoulder_rotation_limit_effort)"
    joint_2_limit_effort="$(arg shoulder_flexion_limit_effort)"
    joint_3_limit_effort="$(arg elbow_flexion_limit_effort)"
    joint_4_limit_effort="$(arg forearm_rotation_limit_effort)"
    joint_5_limit_effort="$(arg wrist_flexion_limit_effort)"
    joint_6_limit_effort="$(arg wrist_rotation_limit_effort)">
    <origin xyz="0 0 0" rpy="0.0 0.0 0.0" />
  </xacro:dynaarm>

  <!-- Include the control plugin -->
  <xacro:include filename="$(find duatic_control)/urdf/plugins.urdf.xacro" />
  <xacro:control namespace="$(arg namespace)" />

</robot>