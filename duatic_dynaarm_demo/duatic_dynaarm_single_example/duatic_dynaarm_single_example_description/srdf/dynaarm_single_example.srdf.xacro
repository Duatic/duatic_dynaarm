<?xml version="1.0"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="dynaarm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- The Dynaarm itself (groups and self-collisions) -->
  <xacro:include filename="$(find duatic_dynaarm_description)/srdf/dynaarm.srdf.xacro" />
  <xacro:dynaarm_srdf standalone="true"/>

  <!-- Table collisions: the 'table' link only exists in this example's URDF -->
  <disable_collisions link1="table" link2="base_plate" reason="Adjacent"/>
  <disable_collisions link1="table" link2="base" reason="Always"/>
  <disable_collisions link1="table" link2="shoulder" reason="Always"/>
  <disable_collisions link1="table" link2="upperarm" reason="Never"/>

</robot>
