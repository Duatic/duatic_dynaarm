<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duatic_dynaarm</name>
  <version>1.0.0</version>
  <description>Everything needed to run a DynaArm: installs its bringup with the driver, description and controllers</description>
  <maintainer email="vpapaspyros@duatic.com">Vaios Papaspyros</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- A build dependency too, so the package is only built where bringup exists -->
  <depend version_gte="1.0.1">duatic_dynaarm_bringup</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <duatic_archive_root>public</duatic_archive_root>
  </export>
</package>
